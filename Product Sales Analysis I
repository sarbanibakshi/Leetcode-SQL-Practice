-- ============================================
-- Problem: Product Sales Analysis I
-- ============================================

-- Table: Sales
-- +-------------+-------+
-- | Column Name | Type  |
-- +-------------+-------+
-- | sale_id     | int   |
-- | product_id  | int   |
-- | year        | int   |
-- | quantity    | int   |
-- | price       | int   |
-- +-------------+-------+
--
-- (sale_id, year) is the primary key.

-- Table: Product
-- +--------------+---------+
-- | Column Name  | Type    |
-- +--------------+---------+
-- | product_id   | int     |
-- | product_name | varchar |
-- +--------------+---------+
--
-- product_id is the primary key.

-- --------------------------------------------
-- Objective:
-- Report the product_name, year, and price
-- for each sale in the Sales table.
-- --------------------------------------------

-- Solution:
SELECT p.product_name, s.year, s.price
FROM Sales s
LEFT JOIN Product p
  ON s.product_id = p.product_id;

-- --------------------------------------------
-- Approach:
-- - LEFT JOIN ensures all sales are included.
-- - Product_names are retrieved from the Product table.
-- --------------------------------------------
