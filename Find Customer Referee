-- ============================================
-- Problem: Find Customer Referee
-- ============================================

-- Table: Customer
-- +-------------+---------+
-- | Column Name | Type    |
-- +-------------+---------+
-- | id          | int     |
-- | name        | varchar |
-- | referee_id  | int     |
-- +-------------+---------+
--
-- id is the primary key.
-- referee_id refers to the id of another customer.

-- --------------------------------------------
-- Objective:
-- Find the names of customers who:
-- 1. Are NOT referred by customer with id = 2
-- OR
-- 2. Have no referee (referee_id IS NULL)
-- --------------------------------------------

-- Solution:
SELECT name
FROM Customer
WHERE referee_id <> 2
   OR referee_id IS NULL;

-- --------------------------------------------
-- Approach:
-- - Exclude customers referred by id = 2
-- - Include customers with NULL referee_id
-- - Use OR to combine both conditions
-- --------------------------------------------
