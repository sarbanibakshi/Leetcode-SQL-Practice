-- ============================================
-- Problem: Average Time of Process per Machine
-- ============================================

-- Table: Activity
-- +----------------+---------+
-- | Column Name    | Type    |
-- +----------------+---------+
-- | machine_id     | int     |
-- | process_id     | int     |
-- | activity_type  | enum    | ('start', 'end')
-- | timestamp      | float   |
-- +----------------+---------+
--
-- (machine_id, process_id, activity_type) is the primary key.

-- --------------------------------------------
-- Objective:
-- Find the average time each machine takes
-- to complete a process.
--
-- processing time = end timestamp - start timestamp
-- Return average processing time per machine,
-- rounded to 3 decimal places.
-- --------------------------------------------

-- Solution:
SELECT a1.machine_id,
       ROUND(AVG(a2.timestamp - a1.timestamp)::numeric, 3) AS processing_time
FROM Activity a1
JOIN Activity a2
  ON a1.machine_id = a2.machine_id
 AND a1.process_id = a2.process_id
 AND a1.activity_type = 'start'
 AND a2.activity_type = 'end'
GROUP BY a1.machine_id;

-- --------------------------------------------
-- Approach:
-- - Self joined Activity table by matching start and end for same machines & processes.
-- - Computed time difference (end - start).
-- - Computed the average per machine using AVG() function.
-- --------------------------------------------
