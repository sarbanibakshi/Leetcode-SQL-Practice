-- ============================================
-- Problem: Project Employees I 
-- ============================================

-- Table: Project
-- +-------------+---------+
-- | Column Name | Type    |
-- +-------------+---------+
-- | project_id  | int     |
-- | employee_id | int     |
-- +-------------+---------+
--
-- (project_id, employee_id) is the primary key.

-- Table: Employee
-- +------------------+---------+
-- | Column Name      | Type    |
-- +------------------+---------+
-- | employee_id      | int     |
-- | name             | varchar |
-- | experience_years | int     |
-- +------------------+---------+
--
-- employee_id is the primary key.

-- --------------------------------------------
-- Objective:
-- Find the average experience years of employees
-- for each project, rounded to 2 decimal places.
-- --------------------------------------------

-- Solution:
SELECT p.project_id,
       ROUND(AVG(e.experience_years), 2) AS average_years
FROM Project p
LEFT JOIN Employee e
  ON p.employee_id = e.employee_id
GROUP BY p.project_id;

-- --------------------------------------------
-- Approach:
-- - Joining Project with Employee using employee_id
-- - Then computing average experience per project
-- - Rounding result to 2 decimal places
-- --------------------------------------------
