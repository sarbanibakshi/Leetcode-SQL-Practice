-- ============================================
-- Problem: Product Price at a Given Date
-- ============================================

-- Table: Products
-- +---------------+---------+
-- | Column Name   | Type    |
-- +---------------+---------+
-- | product_id    | int     |
-- | new_price     | int     |
-- | change_date   | date    |
-- +---------------+---------+
--
-- (product_id, change_date) is the primary key.
-- Initially, all products have price = 10.

-- --------------------------------------------
-- Objective:
-- Find the price of each product on 2019-08-16.
--
-- - Use latest price change on or before that date
-- - If no change exists → price = 10
-- --------------------------------------------

-- Solution:
SELECT product_id,
       new_price AS price
FROM Products
WHERE (product_id, change_date) IN (
    SELECT product_id,
           MAX(change_date)
    FROM Products
    WHERE change_date <= '2019-08-16'
    GROUP BY product_id
)

UNION ALL

SELECT product_id,
       10 AS price
FROM Products
GROUP BY product_id
HAVING MIN(change_date) > '2019-08-16';

-- --------------------------------------------
-- Approach:
-- - Got latest price change before or on given date
-- - Did UNION with products that had no changes yet
-- - Assigned default price = 10 for those products
-- --------------------------------------------
