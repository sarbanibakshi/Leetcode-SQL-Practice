-- ============================================
-- Problem: Customers Who Bought All Products
-- ============================================

-- Table: Customer
-- +-------------+---------+
-- | Column Name | Type    |
-- +-------------+---------+
-- | customer_id | int     |
-- | product_key | int     |
-- +-------------+---------+
--
-- May contain duplicates.

-- Table: Product
-- +-------------+---------+
-- | Column Name | Type    |
-- +-------------+---------+
-- | product_key | int     |
-- +-------------+---------+
--
-- product_key is the primary key.

-- --------------------------------------------
-- Objective:
-- Find customers who bought all products
-- listed in the Product table.
-- --------------------------------------------

-- Solution:
SELECT customer_id
FROM Customer
GROUP BY customer_id
HAVING COUNT(DISTINCT product_key) = (
    SELECT COUNT(product_key)
    FROM Product
);

-- --------------------------------------------
-- Approach:
-- - Counted distinct products bought per customer
-- - Compared with total number of products
-- - If equal → customer bought all products
-- --------------------------------------------
