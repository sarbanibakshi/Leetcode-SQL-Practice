-- ============================================
-- Problem: Friend Requests II: Who Has the Most Friends
-- ============================================

-- Table: RequestAccepted
-- +----------------+---------+
-- | Column Name    | Type    |
-- +----------------+---------+
-- | requester_id   | int     |
-- | accepter_id    | int     |
-- | accept_date    | date    |
-- +----------------+---------+
--
-- (requester_id, accepter_id) is the primary key.

-- --------------------------------------------
-- Objective:
-- Find the person who has the most friends
-- and return their id along with number of friends.
--
-- Friendship is mutual:
-- - requester_id and accepter_id are both friends
-- --------------------------------------------

-- Solution:
SELECT id,
       SUM(num) AS num
FROM (
    SELECT accepter_id AS id,
           COUNT(requester_id) AS num
    FROM RequestAccepted
    GROUP BY accepter_id

    UNION ALL

    SELECT requester_id AS id,
           COUNT(accepter_id) AS num
    FROM RequestAccepted
    GROUP BY requester_id
)
GROUP BY id
ORDER BY num DESC
LIMIT 1;

-- --------------------------------------------
-- Approach:
-- - Counted friends where user is accepter
-- - Counted friends where user is requester
-- - Combined using UNION ALL
-- - Summed total friends per user
-- - Returned user with highest count
-- --------------------------------------------
