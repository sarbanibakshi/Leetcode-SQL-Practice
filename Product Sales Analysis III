-- ============================================
-- Problem: Product Sales Analysis III
-- ============================================

-- Table: Sales
-- +-------------+-------+
-- | Column Name | Type  |
-- +-------------+-------+
-- | sale_id     | int   |
-- | product_id  | int   |
-- | year        | int   |
-- | quantity    | int   |
-- | price       | int   |
-- +-------------+-------+
--
-- (sale_id, year) is the primary key.

-- --------------------------------------------
-- Objective:
-- Find all sales that occurred in the first year
-- each product was sold.
--
-- Return:
-- product_id, first_year, quantity, price
-- --------------------------------------------

-- Solution:
SELECT s1.product_id,
       s2.first_year,
       s1.quantity,
       s1.price
FROM Sales s1
JOIN (
    SELECT product_id,
           MIN(year) AS first_year
    FROM Sales
    GROUP BY product_id
) s2
  ON s1.product_id = s2.product_id
 AND s1.year = s2.first_year;

-- --------------------------------------------
-- Approach:
-- - Found earliest year per product using MIN(year)
-- - Joined back to Sales to get corresponding rows
-- - Filtered only records from first year
-- --------------------------------------------
