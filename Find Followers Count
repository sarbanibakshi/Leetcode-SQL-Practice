-- ============================================
-- Problem: Find Followers Count
-- ============================================

-- Table: Followers
-- +-------------+------+
-- | Column Name | Type |
-- +-------------+------+
-- | user_id     | int  |
-- | follower_id | int  |
-- +-------------+------+
--
-- (user_id, follower_id) is the primary key.

-- --------------------------------------------
-- Problem:
-- For each user, find the number of followers.
-- Return results ordered by user_id (ascending).
-- --------------------------------------------

-- Objective:
SELECT user_id,
       COUNT(follower_id) AS followers_count
FROM Followers
GROUP BY user_id
ORDER BY user_id;

-- --------------------------------------------
-- Approach:
-- - Grouped by user_id
-- - Counted follower_id for each user
-- - Sorted results by user_id
-- --------------------------------------------
