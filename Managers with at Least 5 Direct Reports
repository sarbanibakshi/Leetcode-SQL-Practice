-- ============================================
-- Problem: Managers with at Least 5 Direct Reports (Medium)
-- ============================================

-- Table: Employee
-- +-------------+---------+
-- | Column Name | Type    |
-- +-------------+---------+
-- | id          | int     |
-- | name        | varchar |
-- | department  | varchar |
-- | managerId   | int     |
-- +-------------+---------+
--
-- id is the primary key.
-- managerId refers to another employee's id.

-- --------------------------------------------
-- Objective:
-- Find managers who have at least 5 direct reports.
-- Return their names.
-- --------------------------------------------

-- Solution:
SELECT e1.name
FROM Employee e1
JOIN (
    SELECT managerId, COUNT(id) AS direct_reports
    FROM Employee
    GROUP BY managerId
    HAVING COUNT(id) >= 5
) AS e2
  ON e1.id = e2.managerId;

-- --------------------------------------------
-- Approach:
-- - Employees are grouped by managerId
-- - Direct reports per manager are counted.
-- - COUNT >= 5 helps in filtering the managers with atleast 5 reports.
-- - Join is applied to the table using id in table 1 and managerId in table 2.
-- --------------------------------------------
