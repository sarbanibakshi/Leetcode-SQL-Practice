-- ============================================
-- Problem: Primary Department for Each Employee
-- ============================================

-- Table: Employee
-- +---------------+---------+
-- | Column Name   | Type    |
-- +---------------+---------+
-- | employee_id   | int     |
-- | department_id | int     |
-- | primary_flag  | varchar | ('Y', 'N')
-- +---------------+---------+
--
-- (employee_id, department_id) is the primary key.

-- --------------------------------------------
-- Objective:
-- Report each employee with their primary department.
--
-- - If employee has multiple departments → pick primary_flag = 'Y'
-- - If employee has only one department → return that department
-- --------------------------------------------

-- Solution:
SELECT employee_id, department_id
FROM Employee
WHERE primary_flag = 'Y'

UNION

SELECT employee_id, department_id
FROM Employee
WHERE employee_id IN (
    SELECT employee_id
    FROM Employee
    GROUP BY employee_id
    HAVING COUNT(employee_id) = 1
);

-- --------------------------------------------
-- Approach:
-- - Selected rows where primary_flag = 'Y'
-- - Applied UNION with employees having only one department
-- - Used GROUP BY + HAVING COUNT = 1 to identify them
-- --------------------------------------------
