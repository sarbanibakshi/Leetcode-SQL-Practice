-- ============================================
-- Problem: Classes More Than 5 Students
-- ============================================

-- Table: Courses
-- +-------------+---------+
-- | Column Name | Type    |
-- +-------------+---------+
-- | student     | varchar |
-- | class       | varchar |
-- +-------------+---------+
--
-- (student, class) is the primary key.

-- --------------------------------------------
-- Objective:
-- Find all classes that have at least 5 students.
-- --------------------------------------------

-- Solution:
SELECT class
FROM Courses
GROUP BY class
HAVING COUNT(student) >= 5;

-- --------------------------------------------
-- Approach:
-- - Grouped by class
-- - Counted number of students in each class
-- - Filtered using HAVING for count >= 5
-- --------------------------------------------
