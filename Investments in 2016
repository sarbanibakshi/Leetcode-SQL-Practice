-- ============================================
-- Problem: Investments in 2016
-- ============================================

-- Table: Insurance
-- +-------------+-------+
-- | Column Name | Type  |
-- +-------------+-------+
-- | pid         | int   |
-- | tiv_2015    | float |
-- | tiv_2016    | float |
-- | lat         | float |
-- | lon         | float |
-- +-------------+-------+
--
-- pid is the primary key.

-- --------------------------------------------
-- Objective:
-- Find the sum of tiv_2016 for policyholders who:
-- 1. Have duplicate tiv_2015 values
-- 2. Have unique (lat, lon) locations
--
-- Round result to 2 decimal places.
-- --------------------------------------------

-- Solution:
SELECT ROUND(SUM(tiv_2016)::numeric, 2) AS tiv_2016
FROM Insurance
WHERE (lat, lon) IN (
    SELECT lat, lon
    FROM Insurance
    GROUP BY lat, lon
    HAVING COUNT(*) = 1
)
AND tiv_2015 IN (
    SELECT tiv_2015
    FROM Insurance
    GROUP BY tiv_2015
    HAVING COUNT(tiv_2015) > 1
);

-- --------------------------------------------
-- Approach:
-- - Identified unique locations using GROUP BY lat, lon
-- - Identified duplicate tiv_2015 values
-- - Filtered records satisfying both conditions
-- - Summed tiv_2016 and round to 2 decimals
-- --------------------------------------------
