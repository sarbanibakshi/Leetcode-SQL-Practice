-- ============================================
-- Problem: Monthly Transactions I
-- ============================================

-- Table: Transactions
-- +---------------+---------+
-- | Column Name   | Type    |
-- +---------------+---------+
-- | id            | int     |
-- | country       | varchar |
-- | state         | enum    | ('approved', 'declined')
-- | amount        | int     |
-- | trans_date    | date    |
-- +---------------+---------+
--
-- id is the primary key.

-- --------------------------------------------
-- Objective:
-- For each month and country, find:
-- - total number of transactions
-- - total transaction amount
-- - number of approved transactions
-- - total approved transaction amount
-- --------------------------------------------

-- Solution:
SELECT TO_CHAR(trans_date, 'YYYY-MM') AS month,
       country,
       COUNT(*) AS trans_count,
       SUM(CASE WHEN state = 'approved' THEN 1 ELSE 0 END) AS approved_count,
       SUM(amount) AS trans_total_amount,
       SUM(CASE WHEN state = 'approved' THEN amount ELSE 0 END) AS approved_total_amount
FROM Transactions
GROUP BY month, country;

-- --------------------------------------------
-- Approach:
-- - Extracted month using TO_CHAR
-- - Grouped by month and country
-- - Used COUNT and SUM for totals
-- - Used CASE WHEN for conditional aggregation
-- --------------------------------------------
